rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validServiceRequestCreate(requestId) {
      let data = request.resource.data;
      let conversationPath = /databases/$(database)/documents/conversations/$(requestId);
      return data.keys().hasOnly([
          'customerId', 'customerName', 'phone', 'email', 'areaId', 'serviceType',
          'equipment', 'makeModel', 'location', 'description', 'urgency',
          'preferredContact', 'status', 'createdAt', 'updatedAt', 'pricingSnapshot'
        ])
        && data.keys().hasAll([
          'customerId', 'customerName', 'phone', 'areaId', 'serviceType',
          'equipment', 'makeModel', 'location', 'description', 'urgency',
          'preferredContact', 'status', 'createdAt', 'updatedAt'
        ])
        && data.customerId is string
        && data.customerId == request.auth.uid
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 30
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 160))
        && data.areaId in ['agricultural-machinery', 'air-conditioning', 'solar-water-heating']
        && data.serviceType is string
        && data.serviceType.size() > 0
        && data.serviceType.size() <= 100
        && data.equipment is string
        && data.equipment.size() <= 100
        && data.makeModel is string
        && data.makeModel.size() <= 100
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 180
        && data.description is string
        && data.description.size() >= 10
        && data.description.size() <= 1500
        && data.urgency in ['Standard', 'Urgent']
        && data.preferredContact == 'In-app'
        && data.status == 'New'
        && data.createdAt is string
        && data.updatedAt is string
        && existsAfter(conversationPath)
        && getAfter(conversationPath).data.customerId == request.auth.uid;
    }

    function validServiceRequestStaffUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'scheduledFor', 'quoteAmount', 'quoteNote', 'internalNote', 'agreedAmount', 'amountPaid', 'paymentStatus', 'paymentMethod', 'paymentReference', 'receiptNumber', 'receiptIssuedAt', 'updatedAt'
        ])
        && data.customerId == resource.data.customerId
        && data.status in [
          'New', 'Reviewing', 'Quote prepared', 'Awaiting customer',
          'Scheduled', 'In progress', 'Completed', 'Cancelled'
        ]
        && data.updatedAt is string
        && (!data.keys().hasAny(['scheduledFor']) || (data.scheduledFor is string && data.scheduledFor.size() <= 40))
        && (data.status != 'Scheduled' || data.keys().hasAny(['scheduledFor']))
        && (!data.keys().hasAny(['quoteAmount']) || (data.quoteAmount is number && data.quoteAmount >= 0))
        && (!data.keys().hasAny(['quoteNote']) || (data.quoteNote is string && data.quoteNote.size() <= 1200))
        && (!data.keys().hasAny(['internalNote']) || (data.internalNote is string && data.internalNote.size() <= 1200));
    }

    function validConversationCreate(conversationId) {
      let data = request.resource.data;
      let requestPath = /databases/$(database)/documents/serviceRequests/$(conversationId);
      return data.keys().hasOnly([
          'customerId', 'customerName', 'serviceRequestId', 'title', 'status',
          'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessagePreview',
          'unreadForCustomer', 'unreadForAdmin'
        ])
        && data.keys().hasAll([
          'customerId', 'customerName', 'serviceRequestId', 'title', 'status',
          'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessagePreview',
          'unreadForCustomer', 'unreadForAdmin'
        ])
        && data.customerId == request.auth.uid
        && data.serviceRequestId == conversationId
        && existsAfter(requestPath)
        && getAfter(requestPath).data.customerId == request.auth.uid
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 100
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.status == 'open'
        && data.createdAt is string
        && data.updatedAt is string
        && data.lastMessageAt is string
        && data.lastMessagePreview == ''
        && data.unreadForCustomer == false
        && data.unreadForAdmin == false;
    }

    function validConversationUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'updatedAt', 'lastMessageAt', 'lastMessagePreview', 'unreadForCustomer',
          'unreadForAdmin', 'status', 'customerLastReadAt', 'adminLastReadAt'
        ])
        && data.customerId == resource.data.customerId
        && data.serviceRequestId == resource.data.serviceRequestId
        && data.title == resource.data.title
        && data.updatedAt is string
        && (!changed.hasAny(['lastMessageAt']) || data.lastMessageAt is string)
        && (!changed.hasAny(['lastMessagePreview']) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 160))
        && (!changed.hasAny(['unreadForCustomer']) || data.unreadForCustomer is bool)
        && (!changed.hasAny(['unreadForAdmin']) || data.unreadForAdmin is bool)
        && (!changed.hasAny(['customerLastReadAt']) || data.customerLastReadAt is string)
        && (!changed.hasAny(['adminLastReadAt']) || data.adminLastReadAt is string)
        && data.status in ['open', 'waiting', 'resolved'];
    }

    function validConversationMessageCreate(conversationId) {
      let data = request.resource.data;
      let parentPath = /databases/$(database)/documents/conversations/$(conversationId);
      let parent = get(parentPath).data;
      return exists(parentPath)
        && (isAdmin() || parent.customerId == request.auth.uid)
        && data.keys().hasOnly(['senderId', 'senderRole', 'text', 'attachment', 'createdAt'])
        && data.keys().hasAll(['senderId', 'senderRole', 'text', 'createdAt'])
        && data.senderId == request.auth.uid
        && data.senderRole == (isAdmin() ? 'admin' : 'customer')
        && data.text is string
        && data.text.size() <= 2000
        && data.createdAt is string
        && (!data.keys().hasAny(['attachment']) || (
          data.attachment is map
          && data.attachment.keys().hasOnly(['url', 'name', 'type', 'size'])
          && data.attachment.keys().hasAll(['url', 'name', 'type', 'size'])
          && data.attachment.url is string
          && data.attachment.url.size() <= 2048
          && data.attachment.name is string
          && data.attachment.name.size() <= 255
          && data.attachment.type in ['image', 'video']
          && data.attachment.size is number
          && data.attachment.size > 0
          && data.attachment.size <= 8388608
        ));
    }

    match /serviceRequests/{requestId} {
      allow create: if signedIn() && validServiceRequestCreate(requestId);
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() && validServiceRequestStaffUpdate();
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow create: if signedIn() && validConversationCreate(conversationId);
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if signedIn()
        && validConversationUpdate()
        && (isAdmin() || (
          resource.data.customerId == request.auth.uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status == 'open')
        ));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow create: if signedIn() && validConversationMessageCreate(conversationId);
        allow read: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid);
        allow update, delete: if false;
      }
    }


    match /servicePricing/{priceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'areaId', 'serviceType', 'startingPrice', 'priceMode', 'unit', 'description', 'active', 'sortOrder', 'sourceNote', 'updatedAt'])
        && request.resource.data.areaId in ['solar-water-heating', 'air-conditioning', 'agricultural-machinery']
        && request.resource.data.serviceType is string && request.resource.data.serviceType.size() > 0 && request.resource.data.serviceType.size() <= 100
        && request.resource.data.priceMode in ['from', 'quote']
        && (request.resource.data.priceMode == 'quote' ? request.resource.data.startingPrice == null : (request.resource.data.startingPrice is number && request.resource.data.startingPrice >= 0))
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.active is bool
        && request.resource.data.sortOrder is number && request.resource.data.sortOrder >= 1 && request.resource.data.sortOrder <= 500
        && request.resource.data.sourceNote is string && request.resource.data.sourceNote.size() <= 1000;
      allow delete: if isAdmin();
    }

    match /servicePromotions/{promotionId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'title', 'description', 'imageUrl', 'alt', 'order', 'active'])
        && request.resource.data.id == promotionId
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.alt is string && request.resource.data.alt.size() <= 200
        && request.resource.data.order is number && request.resource.data.order >= 1 && request.resource.data.order <= 100
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /notificationPreferences/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['enabled', 'leadMinutes', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.leadMinutes in [5, 10, 15, 20, 30, 45, 60]
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
    }

    match /notificationTokens/{uid}/tokens/{tokenId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['token', 'admin', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.admin == isAdmin()
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
    }

    // No other collection is readable or writable until its product workflow is defined.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
